# ─── Company branding (read by portal + orchestrator) ────────────
COMPANY_NAME="Acme Corp"
COMPANY_DOMAIN="acme.com"
COMPANY_BRAND_COLOR="#3b82f6"
COMPANY_LOGO_URL=""
COMPANY_OFFICE_CITY="Chennai"
COMPANY_OFFICE_ADDRESS="DLF IT Park, Chennai 600032"

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Auth (demo only — do not deploy) ────────────────────────────
AUTH_USERS='[{"username":"hr","password":"acme2026","name":"HR User"},{"username":"admin","password":"acme2026","name":"Admin"}]'
AUTH_SESSION_SECRET="dev-secret-change-me-32-bytes-min"

# ─── Demo flags ──────────────────────────────────────────────────
DEMO_MODE="true"
DEBUG_TOOL_CALLS="false"
DEMO_DELAY_MS="300"        # artificial per-tile delay so flips are visible

# ─── Orchestrator URL (portal proxies to this) ───────────────────
ORCHESTRATOR_URL="http://localhost:3001"

# ─── Azure OpenAI (chat agent + voice Realtime) ──────────────────
# If unset, chat/voice fall back to deterministic mock LLM responses.
AZURE_OPENAI_ENDPOINT=""                   # e.g. https://my-resource.openai.azure.com
AZURE_OPENAI_API_KEY=""                    # key from Azure portal
AZURE_OPENAI_API_VERSION="2024-10-21"
AZURE_OPENAI_CHAT_DEPLOYMENT=""            # text chat deployment name (gpt-4o, gpt-5, etc.)
AZURE_OPENAI_REALTIME_DEPLOYMENT=""        # realtime voice deployment name (gpt-4o-realtime-preview, etc.)

# ─── Azure Communication Services Email ──────────────────────────
# If unset, emails are logged to stdout and email.sent events still fire (mock).
AZURE_COMM_CONNECTION_STRING=""            # endpoint=...;accesskey=...
AZURE_COMM_SENDER_ADDRESS=""               # DoNotReply@<resource>.azurecomm.net

# ─── Tavily web search (welcome agent only, for relocation) ──────
# If unset, welcome agent skips accommodation suggestions in the email body.
TAVILY_API_KEY=""
