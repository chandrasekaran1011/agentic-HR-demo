{
  "name": "hr-agent-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "docker compose -f deploy/docker-compose.dev.yml up -d && (npm --workspace=orchestrator run dev & npm --workspace=portal run dev) && wait",
    "build": "npm --workspace=shared run build && npm --workspace=portal run build",
    "test": "npm --workspaces --if-present run test",
    "test:e2e": "playwright test",
    "orchestrator": "npm --workspace=orchestrator run dev",
    "portal": "npm --workspace=portal run dev",
    "seed": "tsx scripts/seed.ts",
    "reset": "bash scripts/reset-demo.sh",
    "rehearse": "tsx scripts/rehearse.ts",
    "redis": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "redis:stop": "docker compose -f deploy/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "postcss": "^8.5.10",
    "vite": "^7.0.0"
  }
}
