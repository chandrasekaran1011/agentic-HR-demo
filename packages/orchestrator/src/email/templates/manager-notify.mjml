<mjml>
  <mj-head>
    <mj-title>New joiner: {{candidate_name}}</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#1f2937" font-size="14px" line-height="1.5" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-section background-color="{{brand_color}}" padding="24px">
      <mj-column>
        <mj-text color="#ffffff" font-size="18px" font-weight="600">New joiner alert</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text>Hi {{manager_name}},</mj-text>
        <mj-text><strong>{{candidate_name}}</strong> ({{role}}) joins the {{team}} team on <strong>{{joining_date}}</strong>.</mj-text>
        <mj-text font-weight="600" padding-top="12px">Your manager checklist</mj-text>
        <mj-text>
          • Schedule a 1:1 for day 1<br/>
          • Confirm laptop is ready at reception<br/>
          • Add to recurring team meetings<br/>
          • Pair with their assigned buddy
        </mj-text>
        <mj-text color="#64748b" font-size="12px" padding-top="16px">— HR @ {{company_name}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
