<mjml>
  <mj-head>
    <mj-title>Action required: documents for your onboarding</mj-title>
    <mj-attributes>
      <mj-all font-family="Inter, Helvetica, Arial, sans-serif" />
      <mj-text color="#1f2937" font-size="14px" line-height="1.5" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f8fafc">
    <mj-section background-color="{{brand_color}}" padding="24px">
      <mj-column>
        <mj-text color="#ffffff" font-size="18px" font-weight="600">Documents needed</mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text>Hi {{candidate_name}},</mj-text>
        <mj-text>Please upload the following documents before your joining date ({{joining_date}}):</mj-text>
        <mj-text>{{documents_list}}</mj-text>
        <mj-text font-weight="600" padding-top="12px">Deadline</mj-text>
        <mj-text>{{deadline}} — please do not wait until day 1.</mj-text>
        <mj-text color="#64748b" font-size="12px" padding-top="16px">— HR @ {{company_name}}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
